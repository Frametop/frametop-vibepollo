[Unit]
Description=Vibepollo host input socket (Frametop)
Documentation=https://github.com/Frametop/frametop-vibepollo
# On by default: the package enables it once (vibepollo-host-input-default). Turning it
# off is the host owner's call, and upgrades keep it off:
#   systemctl disable --now vibepollo-host-input.socket

[Socket]
ListenSequentialPacket=/run/vibepollo/host-input.sock
SocketMode=0660
SocketUser=root
SocketGroup=vibepollo
DirectoryMode=0755
Accept=no
RemoveOnStop=yes
Backlog=4

[Install]
WantedBy=sockets.target
