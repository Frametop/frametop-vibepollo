[Unit]
Description=Vibepollo host input socket (Frametop)
Documentation=https://github.com/Frametop/frametop-vibepollo
# Off until enabled: reading this computer's keyboards is the host owner's call.
#   systemctl enable --now vibepollo-host-input.socket

[Socket]
ListenSequentialPacket=/run/vibepollo/host-input.sock
SocketMode=0660
SocketUser=root
SocketGroup=vibepollo
DirectoryMode=0755
Accept=no
RemoveOnStop=yes
Backlog=4

[Install]
WantedBy=sockets.target
