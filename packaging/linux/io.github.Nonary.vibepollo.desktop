[Desktop Entry]
Categories=RemoteAccess;Network;
Comment=@PROJECT_DESCRIPTION@
# Native packages run Vibepollo as system services, which the session controller starts at
# login (vibepollo-session-controller.service, vibepollo.service). There is no user unit to
# start and no tray icon, so the menu entry opens the Web UI on its default port.
Exec=xdg-open https://localhost:47990
Icon=@SUNSHINE_DESKTOP_ICON@
StartupWMClass=@PROJECT_FQDN@
Keywords=vibepollo;gamestream;stream;moonlight;remote play;
Name=@PROJECT_NAME@
Type=Application
Version=1.0
